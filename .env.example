PORT=8989
PROD=false
DB_PATH=monitor.db
LOG_PATH=/var/log/caddy/access.log
AUTH_USER=admin
AUTH_PASS=changeme
# Retention horizons, in days. Raw events expire fast because nothing in the UI
# reads them past 30 days; long-run history lives in the daily_stats and
# uptime_daily rollups, which are kept for ~13 months.
#
# Comments must be on their own line — neither the .env parser nor systemd's
# EnvironmentFile strips trailing comments, so "30  # raw" is not the number 30.
# A value that fails to parse falls back to the default.
#
# raw requests
RETENTION_DAYS=30
# raw uptime_checks (the highest-volume table)
UPTIME_RETENTION_DAYS=14
# app_logs at ERROR
APP_LOG_RETENTION_DAYS=90
# app_logs below ERROR (WARN/INFO/DEBUG)
APP_LOG_NOISE_RETENTION_DAYS=14
ANOMALY_RETENTION_DAYS=90
ALERT_LOG_RETENTION_DAYS=180
LOG_API_KEY=changeme-log-key
# The ONLY alert transport. Leave it empty and every alert is silently dropped —
# the alert log and "last fired" column still populate, so the UI looks healthy.
# Discord → Server Settings → Integrations → Webhooks → New Webhook → copy URL.
DISCORD_WEBHOOK_URL=
GEOIP_DB_PATH=/var/lib/GeoIP/GeoLite2-City.mmdb
# Comma-separated hosts to exclude from logging (e.g. monitor's own hostname)
IGNORE_HOSTS=monitor.yourdomain.com
# Comma-separated user-agent substrings to exclude, in addition to monitor's own
# uptime probes (which are always skipped). Leave empty unless you have a
# specific need — do NOT put "Go-http-client" here: it is the default UA of any
# Go program, so it would hide Go-written scanners from the request log and from
# bot matching.
IGNORE_USER_AGENTS=
# Log shipping to monitor portal (set both to enable)
MONITOR_URL=
MONITOR_API_KEY=

